<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS capture: read the inbox for a historical scan, receive live messages. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Post transaction notifications (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Telephony is optional so the plugin can ship in builds for non-phone form
         factors (ChromeOS/tablets) without making the host app phone-only. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application>
        <!-- Manifest-declared SMS receiver. Live delivery to Dart is via a
             dynamically-registered receiver while the EventChannel has a
             listener; this declaration carries the BROADCAST_SMS-gated
             capability. priority high so we see messages before lower-priority
             receivers. -->
        <receiver
            android:name="com.cashew.pennywise.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
